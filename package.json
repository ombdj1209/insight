{
  "name": "insight-windows",
  "productName": "Insight",
  "version": "0.5.0",
  "description": "Insight: a private, on-device meeting companion for Windows. Live transcription in 53 languages, AI notes, promise tracking, cited answers from your files, live captions with translation, Google and Microsoft 365 integration, and a desktop pet.",
  "main": "./out/main/index.js",
  "author": "Om Prakash Bharadwaj",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "setup:models": "node scripts/setup-models.mjs",
    "dist": "electron-vite build && electron-builder --win --x64",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mui/stylis-plugin-rtl": "^9.5.0",
    "extract-zip": "^2.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "sherpa-onnx-node": "^1.13.8",
    "unpdf": "^1.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource/roboto": "^5.2.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ombdj1209/insight.git"
  },
  "keywords": [
    "meeting-notes",
    "transcription",
    "on-device-ai",
    "electron",
    "windows",
    "gemma",
    "llama.cpp",
    "whisper",
    "rag",
    "multilingual"
  ]
}
